temporal_turnover_survey <- biotic_df |>
  arrange(site, survey_date) |>
  group_by(site) |>
  group_modify(\(.x, .y) {
    comm <- .x |>
      select(all_of(biotic_cols)) |>
      mutate(across(everything(), ~ replace_na(.x, 0))) |>
      as.matrix()
    storage.mode(comm) <- "double"
    turnover <- c(
      NA_real_,
      map_dbl(2:nrow(comm), \(i)
              vegan::vegdist(
                rbind(c(comm[i - 1, ], dummy = 1), c(comm[i, ], dummy = 1)),
                method = "bray"
              ) |> as.numeric()
      )
    )
    .x |> mutate(temporal_turnover = turnover)
  }) |>
  ungroup() |>
  group_by(site) |>
  mutate(cumulative_turnover = cumsum(replace_na(temporal_turnover, 0))) |>
  ungroup()

