outer_sites <- c("Flat Rock", "Flinders Reef", "Shag Rock")

## 2c. Recode raw columns into analysis categories
# Averages across transects to one row per site x survey month, and joins
# on distance-from-river. Two exclusions applied here are analysis
# decisions, not data errors — see comments below.

df_analysis <- raw |>
  mutate(
    year = as.integer(year),
    month = as.integer(month),
    
    # Merge bleached and non-bleached point-count columns into single taxa,
    # since bleaching status is tracked separately from the compositional
    # analysis in this manuscript.
    Corallimorpharia = `Bleached.Corallimorpharia` + Corallimorpharia,
    Pocillopora_Stylophora = Bleached_Pocillopora + Pocillopora_Stylophora,
    
    Massive = Small_Massive_encrusting_corals +
      Medium_Massive_encrusting_corals +
      Large_Massive_encrusting_corals,
    
    Sand = Sand + `BMA.on.sand`,
    
    # CCA_EAM columns are routed to Reef_framework at inner-bay sites and
    # Exposed_rock at outer sites (these substratum types are mutually
    # exclusive by site in the original survey design).
    Reef_framework = case_when(
      site %in% inner_bay_sites ~ CCA_EAM_Rubble + CCA_EAM_Hard_Substrate,
      TRUE ~ 0
    ),
    Exposed_rock = case_when(
      site %in% outer_sites ~ CCA_EAM_Rubble + CCA_EAM_Hard_Substrate,
      TRUE ~ 0
    ),
    
    survey_date = as.Date(paste(year, month, "01", sep = "-")),
    site_trans = paste(site, transect, sep = "_T")
  ) |>
  select(date_utc, survey_date, year, month, month_category, site, transect,
         site_trans, all_of(comm_cols)) |>

  group_by(site, survey_date, year, month, month_category) |>
  summarise(
    across(all_of(comm_cols), \(x) mean(x, na.rm = TRUE)),
    n_transects = n_distinct(site_trans),
    .groups = "drop"
  ) |>
  left_join(dist_lut, by = "site") |>
  mutate(
    survey_id = paste(site, year, sprintf("%02d", month), sep = "_"),
    year_month = paste(year, sprintf("%02d", month), sep = "-"),
    fl = paste0(site, "  (", round(dist_km, 1), " km)"),
    fl = factor(fl, levels = fl_order)
  ) |>
  
  filter(year != 2020) |>
  
  filter(!(site == "Peel Island" & year == 2025)) |>
  droplevels()

