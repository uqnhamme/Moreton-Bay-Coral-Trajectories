## 6b. Build (or load cached) per-pixel annual DHW maximum 
# Computing the annual maximum composite from ~14,000 daily rasters is slow,
# so it is cached to disk after the first run. If dhw_annual_max_path
# already exists, this section loads it directly; otherwise it rebuilds it
# from the daily GeoTIFFs in dhw_tif_dir (which must already be downloaded
# from NOAA Coral Reef Watch).

if (file.exists(dhw_annual_max_path)) {
  
  dhw_annual_max <- rast(dhw_annual_max_path)
  
} else {
  
  tif_files <- list.files(
    path = path.expand(dhw_tif_dir),
    pattern = "\\.tif(f)?$", recursive = TRUE, full.names = TRUE, ignore.case = TRUE
  )
  if (!length(tif_files)) stop("No GeoTIFF files found in dhw_tif_dir.")
  
  mb_dhw <- rast(tif_files)
  names(mb_dhw) <- make.unique(tools::file_path_sans_ext(basename(tif_files)))
  
  # Per-pixel annual maximum across all daily rasters for that year.
  dhw_annual_max <- mb_dhw |>
    tapp(index = format(time(mb_dhw), "%Y"), fun = max, na.rm = TRUE) |>
    setNames(paste0(unique(format(time(mb_dhw), "%Y"))))
  
  writeRaster(dhw_annual_max, dhw_annual_max_path, overwrite = TRUE)
}

