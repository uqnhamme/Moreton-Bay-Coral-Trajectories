  "tidyverse",    # data wrangling + ggplot2
  "sf",           # site coordinates as spatial points
  "terra",        # raster handling for the fetched basemap tiles
  "tidyterra",    # geom_spatraster_rgb() to plot the basemap
  "maptiles",     # get_tiles() - fetches Esri World Imagery tiles, no API key needed
  "ggspatial",    # annotation_north_arrow(), annotation_scale()
  "ggtext",       # element_markdown()/geom_richtext() for mixed bold/italic labels
  "patchwork"     # combining the main map and the locator inset
)

invisible(lapply(required_packages, library, character.only = TRUE))

output_dir <- "."   # EDIT to your preferred output location
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)


## 1a. Site coordinates
# Same eight sites and coordinates used in the main analysis pipeline.

sites_coords <- tribble(
  ~site,              ~lon,       ~lat,
  "Goat Island",      153.38666, -27.51592,
  "Green Island",     153.24628, -27.42648,
  "Myora Reef",       153.40898, -27.47254,
  "Wellington Point", 153.24707, -27.45656,
  "Peel Island",      153.37662, -27.49697,
  "Flinders Reef",    153.48420, -26.97780,
  "Flat Rock",        153.55100, -27.39130,
  "Shag Rock",        153.52660, -27.41420
)

sites_sf <- st_as_sf(sites_coords, coords = c("lon", "lat"), crs = 4326, remove = FALSE)

## 1b. Map extent

map_bbox <- st_bbox(
  c(xmin = 152.85, ymin = -27.75, xmax = 153.70, ymax = -26.85),
  crs = st_crs(4326)
)

bbox_xmin <- as.numeric(map_bbox["xmin"])
bbox_xmax <- as.numeric(map_bbox["xmax"])
bbox_ymin <- as.numeric(map_bbox["ymin"])
bbox_ymax <- as.numeric(map_bbox["ymax"])


## 2. Fetch satellite basemap tiles

fetch_pad_deg <- 0.08   # degrees of padding beyond map_bbox on every side
fetch_bbox <- st_bbox(
  c(xmin = bbox_xmin - fetch_pad_deg, ymin = bbox_ymin - fetch_pad_deg,
    xmax = bbox_xmax + fetch_pad_deg, ymax = bbox_ymax + fetch_pad_deg),
  crs = st_crs(4326)
)

basemap_tiles <- maptiles::get_tiles(
  x = fetch_bbox,
  provider = "Esri.WorldImagery",
  zoom = 11,
  crop = TRUE
)

basemap_4326 <- terra::project(basemap_tiles, "EPSG:4326")


## 3. Label positions

site_label_pos <- tribble(
  ~site,              ~nudge_x, ~nudge_y, ~hjust,
  "Flinders Reef",     -0.015,   0.000,    1,
  "Flat Rock",          0.015,   0.010,    0,
  "Shag Rock",          0.015,  -0.010,    0,
  "Green Island",       0.015,   0.010,    0,
  "Wellington Point",   0.015,  -0.010,    0,
  "Myora Reef",          0.015,   0.010,    0,
  "Peel Island",        -0.015,   0.000,    1,
  "Goat Island",         0.015,  -0.010,    0
) |>
  left_join(sites_coords, by = "site") |>
  mutate(label_x = lon + nudge_x, label_y = lat + nudge_y)

bay_label <- tribble(
  ~lon,      ~lat,      ~label,
  153.26,   -27.30,    "**MORETON BAY**<br>*(Quandamooka Sea Country)*"
)

island_labels <- tribble(
  ~lon,      ~lat,      ~label,
  153.51,   -27.1,    "**MORETON ISLAND**<br>*(Mulgumpin)*",
  153.59,   -27.5,    "**NORTH STRADBROKE<br>ISLAND**<br>*(Minjerribah)*"
)

river_labels <- tribble(
  ~lon,      ~lat,      ~label,      ~angle,
  153.10,   -27.42,    "Brisbane River",  20
)


## 3c. Latitude/longitude axis breaks
lon_breaks <- seq(ceiling(bbox_xmin / 0.2) * 0.2, floor(bbox_xmax / 0.2) * 0.2, by = 0.2)
lat_breaks <- seq(ceiling(bbox_ymin / 0.2) * 0.2, floor(bbox_ymax / 0.2) * 0.2, by = 0.2)

lon_label_fun <- function(x) paste0(sprintf("%.1f", x), "\u00B0E")
lat_label_fun <- function(x) paste0(sprintf("%.1f", abs(x)), "\u00B0S")


## 4. Build the main map

main_map <- ggplot() +
  tidyterra::geom_spatraster_rgb(data = basemap_4326, maxcell = 5e6) +
  geom_segment(
    data = site_label_pos,
    aes(x = lon, y = lat, xend = label_x, yend = label_y),
    colour = "white", linewidth = 0.4, alpha = 0.8
  ) +
  geom_point(
    data = sites_sf, aes(geometry = geometry),
    stat = "sf_coordinates", shape = 21, size = 3,
    fill = "white", colour = "black", stroke = 0.8
  ) +
  geom_text(
    data = site_label_pos,
    aes(x = label_x, y = label_y, label = site, hjust = hjust),
    colour = "white", size = 4.2, fontface = "bold"
  ) +
  geom_text(
    data = river_labels,
    aes(x = lon, y = lat, label = label, angle = angle),
    colour = "white", size = 4.2, fontface = "bold"
  ) +
  ggtext::geom_richtext(
    data = bay_label,
    aes(x = lon, y = lat, label = label),
    colour = "white", size = 4.2, fill = NA, label.color = NA,
    hjust = 0.5
  ) +
  ggtext::geom_richtext(
    data = island_labels,
    aes(x = lon, y = lat, label = label),
    colour = "white", size = 4.2, fill = NA, label.color = NA,
    hjust = 0.5
  ) +
  annotate(
    "text",
    x = bbox_xmax - 0.01, y = bbox_ymin + 0.015,
    label = "Esri, Maxar, Earthstar Geographics",
    colour = "white", size = 2.6, hjust = 1, vjust = 0
  ) +
  scale_x_continuous(breaks = lon_breaks, labels = lon_label_fun) +
  scale_y_continuous(breaks = lat_breaks, labels = lat_label_fun) +
  coord_sf(
    xlim = c(bbox_xmin, bbox_xmax),
    ylim = c(bbox_ymin, bbox_ymax),
    crs = st_crs(4326),
    expand = FALSE
  ) +
  ggspatial::annotation_north_arrow(
    location = "tr", which_north = "true",
    style = ggspatial::north_arrow_fancy_orienteering(
      text_col = "white", line_col = "white", fill = c("white", "white")
    ),
    height = unit(1.2, "cm"), width = unit(1.2, "cm")
  ) +
  theme_bw(base_size = 11) +
  theme(
    panel.grid = element_blank(),
    panel.border = element_rect(fill = NA, colour = "black", linewidth = 0.8),
    axis.title = element_blank(),
    axis.text = element_text(colour = "black", size = 10),
    axis.ticks = element_line(colour = "black"),
    axis.ticks.length = unit(0.15, "cm"),
    plot.margin = margin(4, 4, 4, 4)
  )


## 5. Australia-wide locator inset

australia_bbox <- st_bbox(
  c(xmin = 112, ymin = -44, xmax = 154, ymax = -10),
  crs = st_crs(4326)
)

australia_tiles <- maptiles::get_tiles(
  x = australia_bbox,
  provider = "Esri.WorldImagery",
  zoom = 5,
  crop = TRUE
)

australia_4326 <- terra::project(australia_tiles, "EPSG:4326")

locator_inset <- ggplot() +
  tidyterra::geom_spatraster_rgb(data = australia_4326, maxcell = 2e6) +
  annotate(
    "rect",
    xmin = bbox_xmin, xmax = bbox_xmax,
    ymin = bbox_ymin, ymax = bbox_ymax,
    colour = "red", fill = NA, linewidth = 2
  ) +
  coord_sf(
    xlim = c(australia_bbox["xmin"], australia_bbox["xmax"]),
    ylim = c(australia_bbox["ymin"], australia_bbox["ymax"]),
    expand = FALSE
  ) +
  theme_void() +
  theme(
    panel.border = element_rect(fill = NA, colour = "black", linewidth = 0.6)
  )

## ---- 6. Combine main map and inset, then save -------------------------------

figure_site_map <- main_map +
  inset_element(
    locator_inset,
    left = 0.02, bottom = 0.72, right = 0.28, top = 0.98
  )

figure_site_map

fig_width_in <- 9
map_aspect_ratio <- ((bbox_xmax - bbox_xmin) * cos(mean(c(bbox_ymin, bbox_ymax)) * pi / 180)) /
  (bbox_ymax - bbox_ymin)
fig_height_in <- fig_width_in / map_aspect_ratio

ggsave(
  filename = file.path(output_dir, "Figure_site_map.png"),
  plot = figure_site_map, width = fig_width_in, height = fig_height_in, dpi = 300
)

## END OF SCRIPT
