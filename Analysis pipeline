## 5. STATISTICS — Distance-based PERMANOVA with site x time random slopes
# Formally tests for a directional trend in benthic composition through
# time, independent of site identity. Uses the FULL 15-category matrix
# (comm_cols, including substratum classes), NOT the biotic-only matrix
# used in Figures 1-2 — this test is deliberately scoped to the whole
# benthos. Requires the `distmer` package (see Section 0a for install).

permanova_input <- biotic_df |>
  arrange(site, survey_date) |>
  mutate(
    site = factor(site),
    survey_id = paste(site, year, sprintf("%02d", month), sep = "_"),
    time_years = as.numeric(survey_date - min(survey_date)) / 365.25
  )

stopifnot(
  !anyDuplicated(permanova_input$survey_id),
  !anyDuplicated(paste(permanova_input$site, permanova_input$survey_date))
)

# Full 15-category community matrix for this test.
permanova_comm <- permanova_input |>
  select(all_of(comm_cols)) |>
  as.data.frame()
rownames(permanova_comm) <- permanova_input$survey_id

# No missing values expected; this check confirms that before proceeding.
print(colSums(is.na(permanova_comm)))
permanova_comm[is.na(permanova_comm)] <- 0

permanova_matrix <- as.matrix(permanova_comm)
if (any(!is.finite(permanova_matrix))) stop("The community matrix contains non-finite values.")
if (any(permanova_matrix < 0)) stop("The community matrix contains negative values.")
if (any(rowSums(permanova_matrix) == 0)) stop("At least one survey has zero total benthic cover.")

permanova_bray <- vegdist(permanova_matrix, method = "bray")

permanova_diagnostics <- distance_diagnostics(permanova_bray)

# Model: distance ~ time_years + (1 + time_years | site)
#   time_years                     : fixed, average linear temporal trend
#   (1 + time_years | site)        : random site intercept + site-specific slope
n_sites <- nlevels(permanova_input$site)
attainable_sign_flips <- 2^n_sites   # = 256 for 8 sites

time_site_fit <- permanova(
  permanova_bray ~ time_years + (1 + time_years | site),
  data = permanova_input,
  permutations = "all"
)

print(time_site_fit)


