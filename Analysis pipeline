## 3. FIGURE 1 — Cross-shelf community structure and site trajectories
# Reproduces:PCoA ordination with PAM-clustered
# community types (panel A), and site trajectories through time (panel B).

## 3a. Ordination and clustering

pcoa_biotic <- make_survey_pcoa(
  input_df = biotic_df,
  cols = biotic_cols,
  group_name = "Biotic community"
)

survey_biotic_comm <- pcoa_biotic$comm
survey_biotic_bray <- pcoa_biotic$bray

# Select the number of PAM clusters (k = 2-8) by maximizing average
# silhouette width.
sil_biotic_df <- tibble(k = 2:min(8, nrow(survey_biotic_comm) - 1)) |>
  mutate(
    pam_fit = map(k, \(x) cluster::pam(survey_biotic_bray, k = x, diss = TRUE)),
    avg_sil_width = map_dbl(pam_fit, \(x) x$silinfo$avg.width)
  )

best_biotic_k <- sil_biotic_df |>
  slice_max(avg_sil_width, n = 1, with_ties = FALSE) |>
  pull(k)

pam_biotic_fit <- cluster::pam(survey_biotic_bray, k = best_biotic_k, diss = TRUE)

survey_biotic_clusters <- pcoa_biotic$scores |>
  mutate(
    community_type_biotic = factor(pam_biotic_fit$clustering),
    community_type_biotic = fct_reorder(community_type_biotic, as.numeric(community_type_biotic))
  )

# Top 10 taxa by combined |PCoA1| + |PCoA2| loading, for the vector overlay.
