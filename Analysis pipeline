## 2a. PCoA/clustering helper function
# Builds a Bray-Curtis-based PCoA ordination from a community matrix, adds a
# constant "dummy" column (see Methods) to stabilize distances for low-cover
# surveys, computes site-level dispersion (betadisper) and taxon
# weighted-average vectors for plotting. Used to build Figure 1's ordination.

make_survey_pcoa <- function(input_df, cols, group_name = "community", dummy = TRUE) {
  
  survey_df <- input_df |>
    arrange(site, survey_date) |>
    mutate(survey_id = paste(site, year, sprintf("%02d", month), sep = "_"))
  
  survey_comm_raw <- survey_df |>
    select(all_of(cols)) |>
    as.matrix()
  
  survey_comm_raw[is.na(survey_comm_raw)] <- 0
  rownames(survey_comm_raw) <- survey_df$survey_id
  
  survey_comm <- survey_comm_raw
  
  # Constant dummy variable (value = 1 for every survey), appended before
  # calculating Bray-Curtis dissimilarities, to stabilize distance estimates
  # for surveys with low or zero cover across multiple categories.
  if (isTRUE(dummy)) {
    survey_comm <- survey_comm |>
      as.data.frame() |>
      mutate(dummy = 1) |>
      as.matrix()
  }
  
  survey_bray <- vegan::vegdist(survey_comm, method = "bray")
  
  survey_pcoa <- cmdscale(survey_bray, k = 2, eig = TRUE, add = TRUE)
  
  eig_pos <- survey_pcoa$eig[survey_pcoa$eig > 0]
  pct_exp <- round(eig_pos[1:2] / sum(eig_pos) * 100, 1)
  
  survey_scores <- as.data.frame(survey_pcoa$points) |>
    setNames(c("PCoA1", "PCoA2")) |>
    bind_cols(
      survey_df |>
        select(site, year, month, year_month, survey_date, month_category,
               dist_km, fl, survey_id)
    )
  
  # Within-site dispersion: each survey's distance from its site's OVERALL
  # centroid (across all years), rescaled 0-1.
  survey_betadisper_site <- vegan::betadisper(
    d = survey_bray,
    group = survey_df$site,
    type = "centroid"
  )
  
  survey_scores <- survey_scores |>
    mutate(
      distance_from_site_centroid_full = survey_betadisper_site$distances,
      stability_from_site_centroid_full =
        1 - distance_from_site_centroid_full /
        max(distance_from_site_centroid_full, na.rm = TRUE)
    )
  
  # Species weighted-average scores, computed on the RAW (non-dummy-augmented)
  # matrix, used to plot taxon vectors on the ordination.
  wa_scores <- vegan::wascores(survey_pcoa$points, survey_comm_raw)
  
  taxa_df <- as.data.frame(wa_scores) |>
    setNames(c("PCoA1", "PCoA2")) |>
    rownames_to_column("taxon") |>
    mutate(taxon = taxon |> str_replace_all("_", " ") |> str_replace_all("\\.", " "))
  
  # Scale taxon vectors to ~60% of the ordination's spatial extent so they
  # are visible alongside the site points without dominating the plot.
  vec_scale <- 0.6 *
    max(abs(range(survey_scores$PCoA1)), abs(range(survey_scores$PCoA2))) /
    max(sqrt(taxa_df$PCoA1^2 + taxa_df$PCoA2^2))
  
  taxa_scaled <- taxa_df |>
    mutate(PCoA1s = PCoA1 * vec_scale, PCoA2s = PCoA2 * vec_scale)
  
  list(
    name = group_name,
    survey_df = survey_df,
    comm_raw = survey_comm_raw,
    comm = survey_comm,
    bray = survey_bray,
    pcoa = survey_pcoa,
    pct_exp = pct_exp,
    scores = survey_scores,
    taxa = taxa_df,
    taxa_scaled = taxa_scaled,
    betadisper_site = survey_betadisper_site
  )
}

